# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Misc
.env
.env.local

# Build artifacts
__pycache__/
*.pyc
*.pyo

# Local agent / IDE state
.puku-cli/

# BMAD skill output (regenerated on every workflow run)
_bmad/render/

# BMAD-internal working dirs (transient per-skill scratch)
**/.working/
**/imports/

# Regression-sweep report (regenerated on every CI run; uploaded as an
# artifact in the tool-contract-gate workflow, never committed).
.regression-sweep-output.txt

# graphify output (regenerated by the /graphify skill; 7MB+ HTML/JSON/MD).
graphify-out/

# Code-review scratch (transient per-skill session output; not project
# artifacts). `bmad-code-review` writes proposed patches here for the
# human reviewer to inspect; after the review patches are applied or
# rejected, the directory is safe to delete.
.review/

# Diff scratch from ad-hoc analysis (e.g. earlier story wrap-ups).
diff-unique.txt

# Browser/CDP debug artifacts (transient; recreated on every debugging
# session by the smoke harness and ad-hoc CDP scripts).
.test-output/
.chrome-dom-diff.json

